# Copie para scripts/migration/storage/.env e preencha. NUNCA commite valores reais.
# .env está ignorado em scripts/migration/.gitignore.

# ORIGEM (leitura)
SRC_SUPABASE_URL="https://SEU_REF_ORIGEM.supabase.co"
SRC_SERVICE_ROLE_KEY="eyJ...service_role_ORIGEM..."

# DESTINO (escrita)
DEST_SUPABASE_URL="https://SEU_REF_DESTINO.supabase.co"
DEST_SERVICE_ROLE_KEY="eyJ...service_role_DESTINO..."

# Workers concorrentes por bucket (default 8). Reduza se ver muitos 429.
CONCURRENCY=8

# 1 = simula (lista, mas não escreve no destino). 0 = execução real.
DRY_RUN=0

# Restringe a operação a um único bucket (opcional). Ex.: documents
ONLY_BUCKET=

# Limite (bytes) acima do qual o objeto é bufferizado em tmpfile em vez de memória.
# Default 50 MiB.
STREAM_TMPFILE_THRESHOLD=52428800
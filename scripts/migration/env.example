# Copie para .env.migration e preencha. NUNCA commite valores reais.
#
# Origem: projeto Supabase atual (leitura).
# Prefira a conexão DIRECT (porta 5432) em vez do pooler (6543) para \COPY
# streaming grande — o pooler transaction-mode não suporta bem sessões longas.
export SOURCE_DB_URL="postgresql://postgres:SENHA@db.SEU_REF_ORIGEM.supabase.co:5432/postgres?sslmode=require"

# Destino: novo projeto Supabase (escrita).
export TARGET_DB_URL="postgresql://postgres:SENHA@db.SEU_REF_DESTINO.supabase.co:5432/postgres?sslmode=require"

# Paralelismo do export (nº de tabelas exportadas em paralelo). Padrão: 4.
export MIGRATION_PARALLEL=4

# ============================================================================
# Reset de senhas pós-migração (reset-passwords.sh / unmark-must-reset.sh)
# ============================================================================
# URL pública do novo projeto Supabase (DESTINO).
export TARGET_SUPABASE_URL="https://SEU_REF_DESTINO.supabase.co"

# service_role key do DESTINO (obtida no dashboard Supabase → Settings → API).
# Nunca commite. Nunca envie ao frontend.
export TARGET_SERVICE_ROLE_KEY="eyJhbGciOi...service_role..."

# URL base do app publicado; usada no redirectTo do link de recovery.
# Ex.: https://app.singucrm.com  →  redireciona para /reset-password?forced=true
export TARGET_SITE_URL="https://app.singucrm.com"
# ═════════════════════════════════════════════════════════════════
# Template consolidado — migração Supabase → Supabase
# Copie para scripts/migration/.env (git-ignored) e preencha.
# Subpastas (storage/, functions/) podem sobrescrever localmente.
# ═════════════════════════════════════════════════════════════════

# ── ORIGEM (projeto antigo) ─────────────────────────────────────
SRC_SUPABASE_URL=https://<old-ref>.supabase.co
SRC_ANON_KEY=eyJ...
SRC_SERVICE_ROLE_KEY=eyJ...
SRC_DB_URL=postgresql://postgres:<pwd>@db.<old-ref>.supabase.co:5432/postgres

# ── DESTINO (projeto novo) ──────────────────────────────────────
DEST_SUPABASE_URL=https://<new-ref>.supabase.co
DEST_ANON_KEY=eyJ...
DEST_SERVICE_ROLE_KEY=eyJ...
DEST_DB_URL=postgresql://postgres:<pwd>@db.<new-ref>.supabase.co:5432/postgres

# ── Refs curtas (para rewrite-cron-urls.sh) ─────────────────────
OLD_REF=<old-ref>
NEW_REF=<new-ref>

# ── Ajustes de execução ─────────────────────────────────────────
CONCURRENCY=8                    # storage/copy-objects paralelismo
DRY_RUN=0                        # 1 = simular sem escrever
STREAM_TMPFILE_THRESHOLD=52428800 # 50 MiB — buffer vs tmpfile
RATE_LIMIT_BPS=0                 # 0 = ilimitado, ex: 10485760 = 10 MiB/s
PARALLEL=4                       # import-data-parallel
WINDOW_MIN=240                   # janela alvo (dashboard.sh)
SAMPLE_SIZE=200                  # row-diff amostra por tabela

# ── Smoke tests ─────────────────────────────────────────────────
TEST_URL=https://<app>.lovable.app
TEST_EMAIL=
TEST_PASSWORD=

# ── Reset de senhas ─────────────────────────────────────────────
RESET_THROTTLE_RPS=10

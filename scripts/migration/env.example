# ═════════════════════════════════════════════════════════════════
# Template consolidado — migração Supabase → Supabase
# Copie para scripts/migration/.env (git-ignored) e preencha.
# (scripts/migration/env.migration também é lido — mesmo formato.)
# Subpastas (storage/, functions/) podem sobrescrever localmente.
#
# Os scripts LEEM este arquivo (não o executam): KEY=VALUE por linha, aspas
# opcionais, comentário inline após " #". Variável já definida no ambiente
# vence a do arquivo — `PARALLEL=8 ./import-data-parallel.sh` funciona.
# NUNCA commite valores reais. tests/env-docs.test.sh garante que toda
# variável lida pelos scripts está listada aqui (e vice-versa).
# Linhas "# VAR=" são opcionais: descomente para mudar o padrão indicado.
# ═════════════════════════════════════════════════════════════════

# ── ORIGEM (projeto antigo) ─────────────────────────────────────
SRC_SUPABASE_URL=https://<old-ref>.supabase.co
SRC_SERVICE_ROLE_KEY=eyJ...
SRC_DB_URL=postgresql://postgres:<pwd>@db.<old-ref>.supabase.co:5432/postgres
# SOURCE_DB_URL=            # nome legado de SRC_DB_URL (docs/MIGRATION_DATA.md)

# ── DESTINO (projeto novo) ──────────────────────────────────────
DEST_SUPABASE_URL=https://<new-ref>.supabase.co
DEST_ANON_KEY=eyJ...
DEST_SERVICE_ROLE_KEY=eyJ...
DEST_DB_URL=postgresql://postgres:<pwd>@db.<new-ref>.supabase.co:5432/postgres
# TARGET_DB_URL=            # nome legado de DEST_DB_URL
# Senha com caracteres especiais vai percent-encoded na URL (@ → %40). Os
# scripts tiram a senha da linha de comando (ela não aparece em `ps`).

# ── Refs curtas ─────────────────────────────────────────────────
OLD_REF=<old-ref>                # rewrite-cron-urls.sh, verify-deploy.sh
NEW_REF=<new-ref>                # idem; também serve de DEST_REF
# DEST_REF=                 # project-ref de destino (deploy-all, set-secrets, verify-deploy, full-restore)

# ── Confirmação de ações reais ──────────────────────────────────
# Scripts que escrevem pedem confirmação no terminal. Sem terminal use --yes
# ou CONFIRM com o alvo exato que o script mostra (host:porta/banco ou ref).
# CONFIRM=
DRY_RUN=0                        # 1 = simular sem escrever (storage/*, cdc/replay.ts, chaos/inject.sh)

# ── Dados (export/import/compare) ───────────────────────────────
# DATA_DIR=                 # pasta dos CSVs (padrão scripts/migration/data)
# MIGRATION_PARALLEL=4      # jobs do export-data.sh
PARALLEL=4                       # import-data-parallel
WINDOW_MIN=240                   # janela alvo (dashboard.sh)
# REFRESH_SEC=10            # intervalo do dashboard.sh
# NO_COLOR=1                # saída sem cores (compare-counts, post-cutover-watch)
# DDL_OUT_DIR=              # saída do extract-ddl.sh (padrão scripts/migration/ddl)
# EXTENSIONS_SQL=           # arquivo lido por ddl/verify-extensions.sh (padrão ddl/00_extensions.sql)
# PGHOST= PGPORT= PGUSER= PGPASSWORD= PGDATABASE= PGSERVICE= PGSSLMODE=   # libpq; alternativa a SRC_DB_URL no extract-ddl.sh

# ── Auth ────────────────────────────────────────────────────────
# OUT=./auth-identities.csv # saída do auth/export-identities.sh
# IN=./auth-identities.csv  # entrada do auth/import-identities.sh
# ROTATE_MIN_WAIT_HOURS=24  # auth/rotate-jwt.sh: espera mínima entre etapas
# ROTATE_STATE_DIR=         # auth/rotate-jwt.sh: pasta dos carimbos (padrão auth/)
# ROTATE_SKIP_JWKS=0        # 1 = não conferir o JWKS (emergência)

# ── Reset de senhas (reset-passwords.sh / .ts) ──────────────────
# TARGET_SUPABASE_URL=      # padrão: DEST_SUPABASE_URL
# TARGET_SERVICE_ROLE_KEY=  # padrão: DEST_SERVICE_ROLE_KEY
TARGET_SITE_URL=https://<app>.lovable.app
RESET_THROTTLE_RPS=10
# LOG_DIR=                  # logs do reset-passwords.sh (padrão scripts/migration/logs) e do post-cutover-watch.sh (padrão ./logs)

# ── Storage (ver também storage/env.example) ────────────────────
CONCURRENCY=8                    # storage/copy-objects paralelismo
STREAM_TMPFILE_THRESHOLD=52428800 # 50 MiB — buffer vs tmpfile
RATE_LIMIT_BPS=0                 # 0 = ilimitado, ex: 10485760 = 10 MiB/s
# ONLY_BUCKET=              # restringe a um bucket (ou ./storage/run.sh --only)
# STORAGE_ENV_FILE=         # .env alternativo do storage/run.sh

# ── Edge Functions ──────────────────────────────────────────────
# SECRETS_ENV=              # arquivo de secrets do set-secrets.sh (padrão functions/secrets.env)
# HEALTH_JWT=               # JWT de admin para os health checks do verify-deploy.sh
# SUPABASE_ANON_KEY=        # apikey dos health checks do verify-deploy.sh
# DEPLOY_SLEEP_SEC=1        # pausa entre deploys (deploy-all.sh)
# DEPLOY_LOG=               # log do deploy-all.sh (padrão functions/deploy.log)
# LEAK_SCAN_INCLUDE_TESTS=0 # 1 = secrets-leak-scan.sh também varre arquivos de teste
# FUNCTIONS_DIR=            # pasta das functions (padrão supabase/functions)
# FUNCTIONS_BASE_URL=       # base dos health checks (padrão https://<ref>.supabase.co/functions/v1)
# SECRETS_TEMPLATE=         # template lido pelo preflight-secrets.sh

# ── Cutover / freeze ────────────────────────────────────────────
# FREEZE_STATE_DIR=./freeze-state
# FREEZE_ROLES="authenticated anon"
# FREEZE_SCHEMAS="public"
# WINDOW_HRS=24             # monitoring/post-cutover-watch.sh
# INTERVAL_SEC=60

# ── CDC ─────────────────────────────────────────────────────────
# CDC_SLOT=migration_slot   # (cdc/dry-run.sh usa migration_slot_dryrun por padrão)
# CDC_PLUGIN=wal2json
# CDC_OUT_DIR=              # padrão cdc/out (drain) e cdc/out-dryrun (dry-run)
# LAG_MAX_BYTES=1073741824
# LAG_MAX_SEC=30
# POLL_SEC=10
# LAG_MAX_FAILS=5
# AUTO_DRAIN=0              # 1 = lag-watch reanima o drain se o slot ficar sem consumidor
# CDC_DRY_RUN_SEC=30
# SYNTHETIC_WRITES=0
# KEEP_SLOT=0
# SKIP_CLEANUP=0
# REPORT_FILE=

# ── Chaos drill (somente STAGING) ───────────────────────────────
# STAGING_CONFIRM=          # precisa ser exatamente 1
# SCENARIO=
# CHAOS_REVOKE_SEC=60
# PROD_REFS=                # refs/hosts de produção que o chaos se recusa a tocar

# ── DR (backup / restore drill / WAL) ───────────────────────────
# PROD_DB_URL=              # origem do drill (somente leitura)
# DRILL_DB_URL=             # instância EFÊMERA que recebe o restore
# BACKUP_FILE=
# SOURCE_COUNTS_FILE=
# CRITICAL_TABLES=contacts,deals,interactions,companies,whatsapp_messages,user_roles,profiles
# DRIFT_MAX_PCT=0
# DRILL_REPORT_DIR=         # padrão dr/out
# DUMP_CONTAINER=singu-drill
# CONTAINER_BACKUP_FILE=/workspace/.drill/backup.dump
# BACKUP_PASSPHRASE=        # backup GPG/openssl — exporte no shell, não salve em arquivo
# AGE_IDENTITY_FILE=        # chave privada age
# BACKUP_OPENSSL_ARGS="-aes-256-cbc -pbkdf2"
# BACKUP_DEEP_CHECK=1       # 0 = só confere o índice do dump
# ARCHIVE_MAX_LAG_SEC=300
# FAILED_DELTA_MAX=0
# WAL_ARCHIVE_STATE_DIR=    # padrão ~/.local/state/singu-migration
# SNAPSHOT_DIR=             # rollback/full-restore.sh
# RESTORE_ATOMIC=0          # 1 = full-restore em transação única

# ── Verificações (verify/) ──────────────────────────────────────
SAMPLE_SIZE=200                  # row-diff amostra por tabela

# ── Smoke tests ─────────────────────────────────────────────────
TEST_URL=https://<app>.lovable.app
TEST_EMAIL=
TEST_PASSWORD=

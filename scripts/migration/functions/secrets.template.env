# =============================================================================
# Template de secrets para as Edge Functions no NOVO Supabase.
# Copie para `secrets.env` e preencha os valores. NÃO commitar `secrets.env`.
#
# Formato: KEY=VALUE (sem aspas, sem espaços ao redor do `=`).
# Linhas iniciadas por `#` são comentário.
# =============================================================================

# -----------------------------------------------------------------------------
# [AUTO-INJETADAS] Não incluir aqui — o Supabase preenche automaticamente.
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# [APP-OWNED] Segredos que o próprio app usa. Gere valores aleatórios fortes.
# -----------------------------------------------------------------------------
# openssl rand -hex 32
CRON_SECRET=
# Só para CI/testes automatizados; deixe em branco em produção.
TEST_USER_JWT=

# -----------------------------------------------------------------------------
# [LOVABLE AI GATEWAY] Preferencial para chamadas de IA.
# -----------------------------------------------------------------------------
LOVABLE_API_KEY=

# -----------------------------------------------------------------------------
# [TERCEIROS] Copie de cada painel do provedor.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ENRICHLAYER_API_KEY=
FIRECRAWL_API_KEY=
TWILIO_API_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# n8n Webhook Lux
N8N_LUX_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# [BRIDGE - Supabase antigo] Só preencher se a função `external-data` for
# manter leitura do banco de origem durante o cutover. Remova após o corte.
# -----------------------------------------------------------------------------
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_ANON_KEY=
EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=